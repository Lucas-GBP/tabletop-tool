{
  "name": "tabletop-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:ts": "prettier --write .",
    "check:format:ts": "prettier --check .",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "check:format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "format": "npm run format:ts && npm run format:rs",
    "check:format": "npm run check:format:ts && npm run check:format:rs",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features --locked -- -D warnings",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --all-features --locked",
    "bindings:generate": "node scripts/bindings.mts",
    "check:bindings": "node scripts/bindings.mts --check",
    "check:ts": "npm run typecheck && npm run lint && npm run lint:styles && npm run check:format:ts && npm test",
    "check:rs": "npm run check:format:rs && npm run lint:rs && npm run test:rs",
    "check": "npm run check:ts && npm run check:rs && npm run check:bindings"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2"
}
