{
  "name": "tabletop-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:typescript && npm run build:frontend",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "npm run check:format && npm run typecheck && npm run lint && npm test && npm run check:bindings && npm run build:frontend",
    "check:format": "npm run check:prettier && npm run check:rustfmt",
    "check:prettier": "prettier --check .",
    "check:rustfmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:bindings": "node scripts/bindings.mts --check",
    "typecheck": "npm run typecheck:typescript && npm run typecheck:rust",
    "typecheck:typescript": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:rust": "cargo check --manifest-path src-tauri/Cargo.toml --workspace --locked",
    "lint": "npm run lint:typescript && npm run lint:styles && npm run lint:rust",
    "lint:typescript": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features --locked -- -D warnings",
    "test": "npm run test:frontend && npm run test:rust",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --all-features --locked",
    "format": "npm run format:prettier && npm run format:rustfmt",
    "format:prettier": "prettier --write .",
    "format:rustfmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "bindings:generate": "node scripts/bindings.mts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "packageManager": "npm@11.19.0"
}
